digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "_3" [label="_3", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_5" [label="_5", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_2" [label="_2", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_12" [label="_12", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "((_4 as Continue).0: cli::SubCmd)" [label="((_4 as Continue).0: cli::SubCmd)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_6" [label="_6", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_8" [label="_8", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_1)" [label="(*_1)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_4" [label="_4", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_11" [label="_11", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_10" [label="_10", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "((_4 as Break).0: std::result::Result<!, clap::error::Error>)" [label="((_4 as Break).0: std::result::Result<!, clap::error::Error>)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_0" [label="_0", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Ref(Mut { kind: TwoPhaseBorrow })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Call(DefId(21:55 ~ clap_builder[eb16]::derive::FromArgMatches::from_arg_matches_mut))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Call(DefId(2:5011 ~ core[27a8]::ops::try_trait::Try::branch))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_3" [label="Call(DefId(2:5011 ~ core[27a8]::ops::try_trait::Try::branch))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_4" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_5" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_6" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_7" [label="Call(DefId(2:5011 ~ core[27a8]::ops::try_trait::Try::branch))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_8" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_9" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_10" [label="Call(DefId(2:5014 ~ core[27a8]::ops::try_trait::FromResidual::from_residual))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_7" -> "((_4 as Break).0: std::result::Result<!, clap::error::Error>)";
    "op_5" -> "_3";
    "op_2" -> "_4";
    "op_9" -> "_10";
    "op_8" -> "_8";
    "op_1" -> "_5";
    "op_4" -> "_11";
    "op_6" -> "_12";
    "op_0" -> "_6";
    "op_3" -> "((_4 as Continue).0: cli::SubCmd)";
    "op_10" -> "_0";

    // Use Edges (var -> op)
    "_6" -> "op_1";
    "((_4 as Continue).0: cli::SubCmd)" -> "op_4";
    "_11" -> "op_5";
    "_8" -> "op_9";
    "_10" -> "op_10";
    "_2" -> "op_6";
    "_5" -> "op_2";
    "_5" -> "op_7";
    "_5" -> "op_3";
    "((_4 as Break).0: std::result::Result<!, clap::error::Error>)" -> "op_8";
    "(*_1)" -> "op_0";

    // Symbolic Bound Edges (var -> op)
}
