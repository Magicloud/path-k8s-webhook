digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "_2" [label="_2", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_0" [label="_0", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_1" [label="_1", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Call(DefId(146:1004 ~ xitca_http[c82b]::util::service::handler::handler_service))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Call(DefId(146:3075 ~ xitca_http[c82b]::util::service::route::post))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Call(DefId(146:3137 ~ xitca_http[c82b]::util::service::router::IntoObject::into_object))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_1" -> "_1";
    "op_2" -> "_0";
    "op_0" -> "_2";

    // Use Edges (var -> op)
    "_1" -> "op_2";
    "_2" -> "op_1";

    // Symbolic Bound Edges (var -> op)
}
