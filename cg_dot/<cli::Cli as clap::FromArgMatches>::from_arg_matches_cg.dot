digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "_2" [label="_2", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_0" [label="_0", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_4" [label="_4", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_3)" [label="(*_3)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_3" [label="_3", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_1)" [label="(*_1)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_5" [label="_5", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Call(DefId(2:3677 ~ core[27a8]::clone::Clone::clone))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Ref(Mut { kind: Default })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_3" [label="Ref(Mut { kind: Default })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_4" [label="Ref(Mut { kind: TwoPhaseBorrow })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_5" [label="Call(DefId(21:55 ~ clap_builder[eb16]::derive::FromArgMatches::from_arg_matches_mut))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_2" -> "_3";
    "op_0" -> "_5";
    "op_3" -> "(*_3)";
    "op_1" -> "_4";
    "op_5" -> "_0";
    "op_4" -> "_2";

    // Use Edges (var -> op)
    "_5" -> "op_1";
    "(*_3)" -> "op_4";
    "_4" -> "op_2";
    "_4" -> "op_3";
    "(*_1)" -> "op_0";
    "_2" -> "op_5";

    // Symbolic Bound Edges (var -> op)
}
