digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "_10" [label="_10", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_11" [label="_11", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_16" [label="_16", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_0" [label="_0", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_9)" [label="(*_9)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_8" [label="_8", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_5" [label="_5", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(((*_1) as BooleanExpression).0: evalexpr::Node)" [label="(((*_1) as BooleanExpression).0: evalexpr::Node)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_6)" [label="(*_6)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_13)" [label="(*_13)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_6" [label="_6", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_2)" [label="(*_2)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_13" [label="_13", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_4" [label="_4", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_15" [label="_15", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_9" [label="_9", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_7" [label="_7", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_14" [label="_14", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_16)" [label="(*_16)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_12" [label="_12", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Ref(Mut { kind: TwoPhaseBorrow })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_3" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_4" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_5" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_6" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_7" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_8" [label="Call(DefId(2:13895 ~ core[27a8]::fmt::{impl#12}::debug_tuple_field1_finish))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_9" [label="Ref(Mut { kind: TwoPhaseBorrow })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_10" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_11" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_12" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_13" [label="Call(DefId(2:13864 ~ core[27a8]::fmt::{impl#12}::write_str))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_14" [label="Ref(Mut { kind: TwoPhaseBorrow })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_15" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_16" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_17" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_18" [label="Call(DefId(2:13864 ~ core[27a8]::fmt::{impl#12}::write_str))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_1" -> "_11";
    "op_12" -> "_8";
    "op_6" -> "(*_16)";
    "op_3" -> "(*_13)";
    "op_18" -> "_0";
    "op_16" -> "(*_6)";
    "op_10" -> "_9";
    "op_5" -> "_16";
    "op_4" -> "_12";
    "op_11" -> "(*_9)";
    "op_2" -> "_13";
    "op_15" -> "_6";
    "op_7" -> "_15";
    "op_9" -> "_7";
    "op_17" -> "_5";
    "op_0" -> "_10";
    "op_14" -> "_4";

    // Use Edges (var -> op)
    "(*_13)" -> "op_4";
    "_8" -> "op_13";
    "(((*_1) as BooleanExpression).0: evalexpr::Node)" -> "op_0";
    "(*_9)" -> "op_12";
    "_5" -> "op_18";
    "_14" -> "op_8";
    "(*_6)" -> "op_17";
    "_11" -> "op_8";
    "_7" -> "op_13";
    "_4" -> "op_18";
    "_12" -> "op_8";
    "(*_2)" -> "op_1";
    "(*_2)" -> "op_9";
    "(*_2)" -> "op_14";
    "_10" -> "op_5";
    "_10" -> "op_6";
    "(*_16)" -> "op_7";

    // Symbolic Bound Edges (var -> op)
}
