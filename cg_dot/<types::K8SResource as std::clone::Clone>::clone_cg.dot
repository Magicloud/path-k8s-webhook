digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "_7" [label="_7", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_9" [label="_9", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_4)" [label="(*_4)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_4" [label="_4", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "((*_1).2: std::string::String)" [label="((*_1).2: std::string::String)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "((*_1).0: std::string::String)" [label="((*_1).0: std::string::String)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_10" [label="_10", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_10)" [label="(*_10)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_3" [label="_3", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_6" [label="_6", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_8" [label="_8", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_7)" [label="(*_7)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_5" [label="_5", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_2" [label="_2", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "((*_1).1: std::option::Option<std::string::String>)" [label="((*_1).1: std::option::Option<std::string::String>)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_3" [label="Call(DefId(2:3677 ~ core[27a8]::clone::Clone::clone))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_4" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_5" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_6" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_7" [label="Call(DefId(2:3677 ~ core[27a8]::clone::Clone::clone))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_8" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_9" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_10" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_11" [label="Call(DefId(2:3677 ~ core[27a8]::clone::Clone::clone))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_9" -> "(*_10)";
    "op_10" -> "_9";
    "op_2" -> "_3";
    "op_5" -> "(*_7)";
    "op_7" -> "_5";
    "op_0" -> "_4";
    "op_1" -> "(*_4)";
    "op_8" -> "_10";
    "op_11" -> "_8";
    "op_3" -> "_2";
    "op_4" -> "_7";
    "op_6" -> "_6";

    // Use Edges (var -> op)
    "((*_1).2: std::string::String)" -> "op_8";
    "((*_1).2: std::string::String)" -> "op_9";
    "(*_4)" -> "op_2";
    "(*_7)" -> "op_6";
    "_6" -> "op_7";
    "((*_1).0: std::string::String)" -> "op_1";
    "((*_1).0: std::string::String)" -> "op_0";
    "(*_10)" -> "op_10";
    "_3" -> "op_3";
    "_9" -> "op_11";
    "((*_1).1: std::option::Option<std::string::String>)" -> "op_5";
    "((*_1).1: std::option::Option<std::string::String>)" -> "op_4";

    // Symbolic Bound Edges (var -> op)
}
