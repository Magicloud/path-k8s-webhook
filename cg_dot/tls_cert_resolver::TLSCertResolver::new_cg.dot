digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
    }

    // Definition Edges (op -> var)

    // Use Edges (var -> op)

    // Symbolic Bound Edges (var -> op)
}
