digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "_8" [label="_8", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_13" [label="_13", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_2)" [label="(*_2)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_5" [label="_5", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "((_6 as Continue).0: ())" [label="((_6 as Continue).0: ())", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_7" [label="_7", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_11" [label="_11", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "((*_1).0: cli::SubCmd)" [label="((*_1).0: cli::SubCmd)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_9" [label="_9", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_14" [label="_14", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_6" [label="_6", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_3" [label="_3", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_4)" [label="(*_4)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_4" [label="_4", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "((_6 as Break).0: std::result::Result<!, clap::error::Error>)" [label="((_6 as Break).0: std::result::Result<!, clap::error::Error>)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_0" [label="_0", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Ref(Mut { kind: Default })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Ref(Mut { kind: Default })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Ref(Mut { kind: TwoPhaseBorrow })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_3" [label="Ref(Mut { kind: TwoPhaseBorrow })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_4" [label="Call(DefId(21:57 ~ clap_builder[eb16]::derive::FromArgMatches::update_from_arg_matches_mut))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_5" [label="Call(DefId(2:5011 ~ core[27a8]::ops::try_trait::Try::branch))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_6" [label="Call(DefId(2:5011 ~ core[27a8]::ops::try_trait::Try::branch))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_7" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_8" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_9" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_10" [label="Call(DefId(2:5011 ~ core[27a8]::ops::try_trait::Try::branch))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_11" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_12" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_13" [label="Call(DefId(2:5014 ~ core[27a8]::ops::try_trait::FromResidual::from_residual))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_4" -> "_7";
    "op_10" -> "((_6 as Break).0: std::result::Result<!, clap::error::Error>)";
    "op_1" -> "(*_4)";
    "op_2" -> "_8";
    "op_8" -> "_5";
    "op_6" -> "((_6 as Continue).0: ())";
    "op_9" -> "_3";
    "op_3" -> "_9";
    "op_5" -> "_6";
    "op_7" -> "_14";
    "op_11" -> "_11";
    "op_12" -> "_13";
    "op_13" -> "_0";
    "op_0" -> "_4";

    // Use Edges (var -> op)
    "_9" -> "op_4";
    "((_6 as Break).0: std::result::Result<!, clap::error::Error>)" -> "op_11";
    "_7" -> "op_6";
    "_7" -> "op_5";
    "_7" -> "op_10";
    "_14" -> "op_8";
    "_8" -> "op_4";
    "_11" -> "op_12";
    "(*_4)" -> "op_2";
    "_13" -> "op_13";
    "((*_1).0: cli::SubCmd)" -> "op_1";
    "((*_1).0: cli::SubCmd)" -> "op_0";
    "(*_2)" -> "op_3";
    "((_6 as Continue).0: ())" -> "op_7";

    // Symbolic Bound Edges (var -> op)
}
