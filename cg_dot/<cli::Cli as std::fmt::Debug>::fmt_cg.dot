digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "((*_1).0: cli::SubCmd)" [label="((*_1).0: cli::SubCmd)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_3" [label="_3", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_7" [label="_7", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_8" [label="_8", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_7)" [label="(*_7)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_10)" [label="(*_10)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_0" [label="_0", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_11" [label="_11", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_2)" [label="(*_2)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_5)" [label="(*_5)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_4" [label="_4", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_5" [label="_5", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_6" [label="_6", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_9" [label="_9", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_10" [label="_10", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Ref(Mut { kind: TwoPhaseBorrow })", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_3" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_4" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_5" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_6" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_7" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_8" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_9" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_10" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_11" [label="Call(DefId(2:13879 ~ core[27a8]::fmt::{impl#12}::debug_struct_field1_finish))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_4" -> "_7";
    "op_9" -> "(*_10)";
    "op_1" -> "_5";
    "op_7" -> "_11";
    "op_8" -> "_10";
    "op_6" -> "_6";
    "op_0" -> "_3";
    "op_2" -> "(*_5)";
    "op_3" -> "_4";
    "op_5" -> "(*_7)";
    "op_10" -> "_9";
    "op_11" -> "_0";

    // Use Edges (var -> op)
    "(*_10)" -> "op_10";
    "((*_1).0: cli::SubCmd)" -> "op_7";
    "_4" -> "op_11";
    "(*_5)" -> "op_3";
    "(*_2)" -> "op_0";
    "_3" -> "op_11";
    "(*_7)" -> "op_6";
    "_6" -> "op_11";
    "_11" -> "op_8";
    "_11" -> "op_9";
    "_8" -> "op_11";

    // Symbolic Bound Edges (var -> op)
}
