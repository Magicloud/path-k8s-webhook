digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "_6" [label="_6", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_4" [label="_4", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_5" [label="_5", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_2" [label="_2", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_8" [label="_8", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_1)" [label="(*_1)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_3" [label="_3", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(*_2)" [label="(*_2)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_9" [label="_9", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_12" [label="_12", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_13" [label="_13", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_17" [label="_17", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_7" [label="_7", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_11" [label="_11", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_10" [label="_10", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Call(DefId(3:7751 ~ alloc[da1d]::str::{impl#5}::to_ascii_uppercase))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_3" [label="Call(DefId(3:7827 ~ alloc[da1d]::string::{impl#0}::as_str))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_4" [label="Call(DefId(3:7827 ~ alloc[da1d]::string::{impl#0}::as_str))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_5" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_6" [label="Call(DefId(2:39920 ~ core[27a8]::cmp::PartialEq::eq))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_7" [label="Call(DefId(2:12288 ~ core[27a8]::panicking::panic))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_8" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_9" [label="Call(DefId(2:39920 ~ core[27a8]::cmp::PartialEq::eq))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_10" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_11" [label="Call(DefId(2:39920 ~ core[27a8]::cmp::PartialEq::eq))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_12" [label="Ref(Shared)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_13" [label="Call(DefId(2:39920 ~ core[27a8]::cmp::PartialEq::eq))", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_10" -> "_8";
    "op_5" -> "_12";
    "op_2" -> "_3";
    "op_11" -> "_9";
    "op_4" -> "(*_2)";
    "op_8" -> "_10";
    "op_3" -> "_2";
    "op_0" -> "_5";
    "op_9" -> "_11";
    "op_7" -> "_17";
    "op_12" -> "_6";
    "op_1" -> "_4";
    "op_6" -> "_13";
    "op_13" -> "_7";

    // Use Edges (var -> op)
    "_5" -> "op_1";
    "_8" -> "op_11";
    "_6" -> "op_13";
    "_4" -> "op_2";
    "(*_2)" -> "op_5";
    "(*_2)" -> "op_8";
    "(*_2)" -> "op_10";
    "(*_2)" -> "op_12";
    "_3" -> "op_4";
    "_3" -> "op_3";
    "(*_1)" -> "op_0";
    "_12" -> "op_6";
    "_10" -> "op_9";

    // Symbolic Bound Edges (var -> op)
}
